@page "/deploy"
@using DeployTool.Models
@using DeployTool.Services
@inject DeploySession Session
@inject FileScanner FileScanner
@inject NavigationManager Nav

<PageTitle>경로 설정 — DeployTool</PageTitle>

<div class="page-header">
    <h1 class="page-title">
        <span class="title-icon"><i class="bi bi-folder2-open"></i></span>
        경로 설정
    </h1>
    <p class="page-subtitle">운영 서버 경로와 배포 파일 경로를 입력하세요.</p>
</div>

<div style="max-width:520px;display:flex;flex-direction:column;gap:20px;">

    <div class="form-section">
        <label class="form-label">
            <i class="bi bi-server me-1"></i>운영 경로
        </label>
        <input class="form-control" placeholder="예: D:\NETS\O365M"
               @bind="Session.ProductionPath" />
        <div class="field-hint">실제 서비스가 구동 중인 폴더</div>
    </div>

    <div class="form-section">
        <label class="form-label">
            <i class="bi bi-box-arrow-in-down me-1"></i>배포 파일 경로
        </label>
        <input class="form-control" placeholder="예: D:\imprep"
               @bind="Session.DeployPath" />
        <div class="field-hint">새로 빌드된 파일이 위치한 폴더</div>
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle me-2"></i>@_errorMessage
        </div>
    }

        <button type="button"
            class="btn btn-primary"
            style="align-self:flex-start;min-width:160px;"
            @onclick="StartQuickScanAsync"
            @onclick:preventDefault="true"
            disabled="@_isScanning">
        @if (_isScanning)
        {
            <span class="spinner-border spinner-border-sm"></span>
            <span>스캔 중...</span>
        }
        else
        {
            <i class="bi bi-lightning-charge"></i>
            <span>빠른 스캔 시작</span>
        }
    </button>

    <div class="info-box">
        <div class="info-box-title"><i class="bi bi-info-circle me-1"></i>안내</div>
        <ul>
            <li>빠른 스캔은 최상위 폴더 목록만 열거합니다 (1~2초)</li>
            <li>전체 파일 분석은 다음 단계에서 범위를 선택 후 실행됩니다</li>
            <li>각 서버에서 독립적으로 실행하세요</li>
        </ul>
    </div>

</div>

@code {
    private bool _isScanning;
    private string? _errorMessage;

    private async Task StartQuickScanAsync()
    {
        _errorMessage = null;

        if (!Directory.Exists(Session.ProductionPath))
        {
            _errorMessage = $"운영 경로가 존재하지 않습니다: {Session.ProductionPath}";
            return;
        }
        if (!Directory.Exists(Session.DeployPath))
        {
            _errorMessage = $"배포 경로가 존재하지 않습니다: {Session.DeployPath}";
            return;
        }

        _isScanning = true;
        try
        {
            var folders = await FileScanner.QuickScanTopLevelFoldersAsync(
                Session.ProductionPath, Session.DeployPath);
            Session.Scope = new ScopeSelection { AvailableFolders = folders };
            Session.CurrentStep = DeployStep.ScopeSelect;
            Nav.NavigateTo("/deploy/scope");
        }
        catch (Exception ex)
        {
            _errorMessage = $"빠른 스캔 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            _isScanning = false;
        }
    }
}
