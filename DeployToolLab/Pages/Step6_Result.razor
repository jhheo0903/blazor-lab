@page "/deploy/result"
@using DeployTool.Models
@using DeployTool.Services
@inject DeploySession Session
@inject BackupService BackupService
@inject DeployConfigService ConfigService
@inject PostDeployRunner PostDeployRunner
@inject WindowsServiceManager ServiceManager
@inject IisPoolManager PoolManager
@inject NavigationManager Nav

<PageTitle>결과 확인 — DeployTool</PageTitle>

<div class="page-header">
    <h1 class="page-title">
        <span class="title-icon" style="background:var(--green-muted);color:var(--green);"><i class="bi bi-clipboard-check"></i></span>
        배포 결과
    </h1>
</div>

@* ── 결과 요약 ── *@
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:560px;margin-bottom:28px;">
    <div class="result-card success">
        <i class="bi bi-check-circle-fill" style="font-size:22px;color:var(--green);"></i>
        <div class="result-number">@_successCount</div>
        <div class="result-label">성공</div>
    </div>
    <div class="result-card failure">
        <i class="bi bi-x-circle-fill" style="font-size:22px;color:var(--red);"></i>
        <div class="result-number">@_errorCount</div>
        <div class="result-label">실패</div>
    </div>
    <div class="result-card skipped">
        <i class="bi bi-skip-forward-circle" style="font-size:22px;color:var(--text-muted);"></i>
        <div class="result-number">@Session.SkipItems.Count()</div>
        <div class="result-label">스킵</div>
    </div>
</div>

@if (_errorCount > 0)
{
    <div class="card mb-4" style="border-color:var(--red)!important;max-width:640px;">
        <div class="card-header" style="color:var(--red)!important;">
            <i class="bi bi-exclamation-triangle me-2"></i>실패 항목
        </div>
        <div style="max-height:200px;overflow-y:auto;">
            @foreach (var log in _errorLogs)
            {
                <div style="padding:8px 20px;border-bottom:1px solid var(--border-subtle);font-family:var(--font-mono);font-size:12.5px;color:var(--red);">
                    @log.Message
                </div>
            }
        </div>
    </div>
}

@if (_statusMessage is not null)
{
    <div class="alert @(_statusIsError ? "alert-danger" : "alert-success") mb-4" style="max-width:560px;">
        <i class="bi @(_statusIsError ? "bi-exclamation-circle" : "bi-check-circle") me-2"></i>
        @_statusMessage
    </div>
}

@* ── 후속 작업 (deploy-config.json의 postDeployExecutables) + 서비스/풀 재시작 ── *@
@if (_config.PostDeployExecutables.Count > 0 || Session.StoppedServices.Count > 0 || Session.StoppedAppPools.Count > 0)
{
    <div style="max-width:720px;margin-bottom:24px;padding:16px;border:1px solid var(--c-border);border-radius:var(--r);background:var(--c-elevated);">
        <div class="section-label" style="margin-bottom:12px;">
            <i class="bi bi-play-circle me-1" style="color:var(--c-accent);"></i>후속 작업
        </div>

        @if (_config.PostDeployExecutables.Count > 0)
        {
            <div style="display:flex;flex-direction:column;gap:6px;">
                @foreach (var task in _config.PostDeployExecutables)
                {
                    var status = GetStatus(task);
                    <div style="display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--c-border);border-radius:6px;background:var(--c-bg);">
                        @switch (status)
                        {
                            case FollowUpStatus.Running:
                                <span class="spinner-border spinner-border-sm" style="flex-shrink:0;"></span>
                                break;
                            case FollowUpStatus.Succeeded:
                                <i class="bi bi-check-circle-fill" style="color:var(--c-green);flex-shrink:0;"></i>
                                break;
                            case FollowUpStatus.Failed:
                                <i class="bi bi-x-circle-fill" style="color:var(--c-red);flex-shrink:0;"></i>
                                break;
                            default:
                                <i class="bi bi-terminal" style="color:var(--c-text-3);flex-shrink:0;"></i>
                                break;
                        }
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:13px;font-weight:600;">@task.Name</div>
                            <div style="font-size:11.5px;color:var(--c-text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @DescribeSteps(task)
                            </div>
                        </div>
                        <button class="btn btn-outline-primary btn-sm" style="flex-shrink:0;"
                                @onclick="() => RunSingleTaskAsync(task)"
                                disabled="@_isBusy">
                            <i class="bi bi-play-fill"></i> 실행
                        </button>
                    </div>
                }
            </div>

            <button class="btn btn-primary btn-sm" style="margin-top:10px;"
                    @onclick="RunAllTasksAsync" disabled="@_isBusy">
                <i class="bi bi-play-fill"></i> 전체 실행
            </button>
        }

        @if (Session.StoppedServices.Count > 0 || Session.StoppedAppPools.Count > 0)
        {
            <div style="font-size:11.5px;font-weight:600;color:var(--c-text-2);margin:16px 0 8px;text-transform:uppercase;letter-spacing:.04em;">
                재시작 대상
            </div>
            @foreach (var s in Session.StoppedServices)
            {
                <div style="font-size:12.5px;color:var(--c-text-2);margin-bottom:3px;">
                    <i class="bi bi-gear me-1"></i>@s
                </div>
            }
            @foreach (var p in Session.StoppedAppPools)
            {
                <div style="font-size:12.5px;color:var(--c-text-2);margin-bottom:3px;">
                    <i class="bi bi-globe me-1"></i>@p
                </div>
            }

            @if (_restartDone)
            {
                <div class="alert alert-success" style="margin-top:8px;padding:8px 12px;font-size:12.5px;">
                    <i class="bi bi-check-circle-fill me-1"></i>서비스 / 풀 재시작을 실행했습니다. 결과는 로그를 확인하세요.
                </div>
            }
            else
            {
                <button class="btn btn-outline-success btn-sm" style="margin-top:8px;"
                        @onclick="RestartStoppedAsync" disabled="@_isBusy">
                    <i class="bi bi-arrow-clockwise"></i> 서비스 / 풀 재시작
                </button>
            }
        }

        @if (_taskLogs.Count > 0)
        {
            <div style="display:flex;align-items:center;justify-content:space-between;margin:14px 0 6px;">
                <div style="font-size:11.5px;font-weight:600;color:var(--c-text-2);">실행 로그 (최신이 위)</div>
                <button class="btn btn-link btn-sm" style="padding:0;font-size:11.5px;"
                        @onclick="() => _taskLogs.Clear()" disabled="@_isBusy">지우기</button>
            </div>
            <div style="max-height:360px;overflow-y:auto;background:var(--c-bg);border:1px solid var(--c-border);border-radius:4px;padding:8px;">
                @for (var i = _taskLogs.Count - 1; i >= 0; i--)
                {
                    var line = _taskLogs[i];
                    <div style="font-family:var(--mono);font-size:11.5px;color:@GetLogColor(line);white-space:pre-wrap;margin-bottom:1px;">
                        @line
                    </div>
                }
            </div>
        }
    </div>
}

@* ── 하단 버튼 ── *@
<div style="display:flex;gap:10px;flex-wrap:wrap;max-width:560px;">
    @if (Session.BackupPath is not null)
    {
        <button class="btn btn-warning" @onclick="RollbackAsync" disabled="@_isRollingBack">
            @if (_isRollingBack)
            {
                <span class="spinner-border spinner-border-sm"></span>
                <span>롤백 중...</span>
            }
            else
            {
                <i class="bi bi-arrow-counterclockwise"></i>
                <span>롤백 (백업으로 복원)</span>
            }
        </button>
    }
    else if (Session.IsBackupSkipped)
    {
        <span style="align-self:center;font-size:12px;color:var(--yellow);">
            <i class="bi bi-skip-forward-fill me-1"></i>백업을 건너뛰어 롤백할 수 없습니다.
        </span>
    }

    <button class="btn btn-outline-danger" @onclick="CleanQuarantine">
        <i class="bi bi-trash3"></i>
        _quarantine 정리
    </button>

    <button class="btn btn-outline-secondary ms-auto" @onclick="StartNew">
        <i class="bi bi-arrow-repeat"></i>
        새 배포 시작
    </button>
</div>

@code {
    private int _successCount;
    private int _errorCount;
    private List<DeployLogEntry> _errorLogs = [];
    private bool _isRollingBack;
    private string? _statusMessage;
    private bool _statusIsError;

    private DeployConfig _config = new();
    private enum FollowUpStatus { Ready, Running, Succeeded, Failed }

    private readonly Dictionary<PostDeployExecutable, FollowUpStatus> _taskStatus = [];
    private readonly List<string> _taskLogs = [];
    private bool _isBusy;          // 후속 작업 또는 재시작 실행 중 — 한 번에 하나만 실행
    private bool _restartDone;

    protected override async Task OnInitializedAsync()
    {
        _errorLogs = Session.DeployLog.Where(l => l.IsError).OrderBy(l => l.Timestamp).ToList();
        // 실패 = 적용 대상 중 성공하지 못한 항목 (오류·잠김 건너뜀·중단으로 미처리 포함)
        _successCount = Session.DeploySucceededCount;
        _errorCount = Session.ApplyItems.Count() - _successCount;
        _config = await ConfigService.LoadAsync();
    }

    private FollowUpStatus GetStatus(PostDeployExecutable task) =>
        _taskStatus.GetValueOrDefault(task, FollowUpStatus.Ready);

    private static string DescribeSteps(PostDeployExecutable task)
    {
        var steps = task.GetSteps();
        var first = steps[0];
        var target = first.ForEachFile is { } each
            ? $"{Path.GetFileName(first.Path)} × {Path.Combine(each.Directory, each.Pattern)}"
            : $"{Path.GetFileName(first.Path)} {first.Arguments}";
        return steps.Count > 1 ? $"{target} 외 {steps.Count - 1}개 명령" : target;
    }

    private static string GetLogColor(string line)
    {
        if (line.StartsWith("[ERR]") || line.StartsWith("✖")) return "var(--c-red)";
        if (line.StartsWith("▶") || line.StartsWith("✔")) return "var(--c-accent)";
        if (line.StartsWith(">")) return "var(--c-text-3)";
        return "var(--c-text-1)";
    }

    private async Task RunSingleTaskAsync(PostDeployExecutable task)
    {
        if (_isBusy) return;
        _isBusy = true;
        try
        {
            await RunTaskCoreAsync(task);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RunAllTasksAsync()
    {
        if (_isBusy) return;
        _isBusy = true;
        try
        {
            foreach (var task in _config.PostDeployExecutables)
                await RunTaskCoreAsync(task);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RunTaskCoreAsync(PostDeployExecutable task)
    {
        _taskStatus[task] = FollowUpStatus.Running;
        StateHasChanged();

        // Progress<T>는 생성 시점의 회로 컨텍스트로 콜백을 보내므로 목록 변경이 렌더링과 겹치지 않는다
        var progress = new Progress<string>(line =>
        {
            _taskLogs.Add(line);
            StateHasChanged();
        });

        try
        {
            // 파일 열거·프로세스 시작 같은 동기 작업이 회로를 막지 않도록 스레드 풀에서 실행
            var ok = await Task.Run(() => PostDeployRunner.RunAsync(task, progress));
            _taskStatus[task] = ok ? FollowUpStatus.Succeeded : FollowUpStatus.Failed;
        }
        catch (Exception ex)
        {
            _taskLogs.Add($"[ERR] {task.Name} 실행 중 오류: {ex.Message}");
            _taskStatus[task] = FollowUpStatus.Failed;
        }
    }

    // 중지했던 서비스 / IIS 풀 재시작 — 후속 작업과 분리해 필요한 시점에 실행
    private async Task RestartStoppedAsync()
    {
        if (_isBusy) return;
        _isBusy = true;
        try
        {
            _taskLogs.Add("▶ 서비스 / 풀 재시작");
            StateHasChanged();

            foreach (var svc in Session.StoppedServices)
            {
                var (ok, msg) = await ServiceManager.StartAsync(svc);
                _taskLogs.Add($"{(ok ? "✔" : "✖")} {msg}");
                StateHasChanged();
            }
            foreach (var pool in Session.StoppedAppPools)
            {
                var (ok, msg) = await PoolManager.StartAsync(pool);
                _taskLogs.Add($"{(ok ? "✔" : "✖")} {msg}");
                StateHasChanged();
            }
            _restartDone = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RollbackAsync()
    {
        _isRollingBack = true;
        _statusMessage = null;
        try
        {
            var preRollbackScope = new ScopeSelection
            {
                Mode = ScopeMode.FullCompare,
                ExcludePatterns = ["Backup/", "_quarantine/"]
            };
            await BackupService.CreateBackupAsync(Session.ProductionPath, preRollbackScope);
            await BackupService.RestoreBackupAsync(Session.BackupPath!, Session.ProductionPath);
            _statusMessage = "롤백이 완료되었습니다.";
            _statusIsError = false;
        }
        catch (Exception ex)
        {
            _statusMessage = $"롤백 실패: {ex.Message}";
            _statusIsError = true;
        }
        finally
        {
            _isRollingBack = false;
        }
    }

    private void CleanQuarantine()
    {
        try
        {
            DeployExecutor.CleanQuarantine(Session.ProductionPath);
            _statusMessage = "_quarantine 폴더가 정리되었습니다.";
            _statusIsError = false;
        }
        catch (Exception ex)
        {
            _statusMessage = $"정리 실패: {ex.Message}";
            _statusIsError = true;
        }
    }

    private void StartNew()
    {
        Session.CurrentStep = DeployStep.PathConfig;
        Session.Changes.Clear();
        Session.DeployLog.Clear();
        Session.BackupPath = null;
        Session.IsBackupSkipped = false;
        Session.IsDeployDone = false;
        Session.DeploySucceededCount = 0;
        Session.EmptyDeployOnlyDirectories.Clear();
        Session.SelectedServices.Clear();
        Session.SelectedAppPools.Clear();
        Session.StoppedServices.Clear();
        Session.StoppedAppPools.Clear();
        Nav.NavigateTo("/deploy");
    }
}
