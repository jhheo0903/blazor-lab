@using DeployTool.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

<div style="height:100%;display:flex;flex-direction:column;overflow:hidden;">

    @* ── Action bar ─────────────────────────────────────────── *@
    <div class="diff-actionbar">
        <span class="diff-filename">
            <i class="bi bi-file-text" style="font-size:12px;opacity:.6;"></i>
            @Path.GetFileName(Item.RelativePath)
        </span>
        <span class="diff-filepath">@Path.GetDirectoryName(Item.RelativePath)</span>
        <div style="flex:1;"></div>

        @if (_saveError is not null)
        {
            <span style="font-size:11px;color:var(--c-red);">
                <i class="bi bi-exclamation-circle-fill" style="font-size:9px;"></i> @_saveError
            </span>
        }
        @if (_isDirty)
        {
            <span style="font-size:11px;color:var(--c-yellow);">
                <i class="bi bi-circle-fill" style="font-size:7px;"></i> 수정됨
            </span>
        }
        @if (_savedOk)
        {
            <span class="decision-badge decision-apply">
                <i class="bi bi-check-circle-fill me-1"></i>저장됨
            </span>
        }

        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetToOriginalAsync" disabled="@(!_isDirty)">
            <i class="bi bi-arrow-counterclockwise"></i> 원본 복원
        </button>
        <button class="btn btn-primary btn-sm" @onclick="SaveMergeAsync" disabled="@(!_isDirty)">
            <i class="bi bi-floppy"></i> 저장
        </button>
    </div>

    @* ── Sub-header (label row) ───────────────────────────── *@
    <div style="display:flex;justify-content:space-between;padding:5px 16px;font-size:11px;font-weight:600;
                color:var(--c-text-2);background:var(--c-elevated);border-bottom:1px solid var(--c-border);
                text-transform:uppercase;letter-spacing:.04em;flex-shrink:0;">
        <span><i class="bi bi-hdd-stack me-1"></i>운영 (읽기 전용)</span>
        <span><i class="bi bi-pencil-square me-1"></i>배포 @(Item.Status == FileChangeStatus.Deleted ? "(삭제 예정)" : "(편집 가능)")</span>
    </div>

    @* ── Monaco Diff Editor ────────────────────────────────── *@
    <div id="@_editorId" style="flex:1;min-height:0;"></div>

</div>

@code {
    [Parameter] public FileChangeItem Item { get; set; } = default!;
    [Parameter] public string ProductionText { get; set; } = string.Empty;
    [Parameter] public string DeployText { get; set; } = string.Empty;
    [Parameter] public EventCallback OnDecisionChanged { get; set; }

    private readonly string _editorId = "monaco-" + Guid.NewGuid().ToString("N")[..8];
    private DotNetObjectReference<TextDiffPanel>? _dotNetRef;

    private bool _isDirty;
    private bool _savedOk;
    private string? _saveError;

    private string _lastItemId = string.Empty;
    private bool _pendingModelUpdate;

    protected override void OnParametersSet()
    {
        var newId = Item.RelativePath;
        if (_lastItemId == newId) return;

        _lastItemId = newId;
        _isDirty    = Item.MergedJsonContent is not null && Item.MergedJsonContent != DeployText;
        _savedOk    = Item.Decision == DeployDecisionValue.Apply && Item.MergedJsonContent is not null;
        _saveError  = null;
        _pendingModelUpdate = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("monacoEditor.createDiff",
                _editorId,
                ProductionText,
                Item.MergedJsonContent ?? DeployText,
                DetectLanguage(Item.RelativePath),
                Item.Status == FileChangeStatus.Deleted,
                _dotNetRef);
            return;
        }

        if (_pendingModelUpdate)
        {
            _pendingModelUpdate = false;
            await JS.InvokeVoidAsync("monacoEditor.updateModel",
                _editorId, ProductionText, Item.MergedJsonContent ?? DeployText);
        }
    }

    [JSInvokable]
    public void OnMonacoDirty()
    {
        _isDirty = true;
        _savedOk = false;
        _saveError = null;
        StateHasChanged();
    }

    private async Task ResetToOriginalAsync()
    {
        _isDirty   = false;
        _savedOk   = false;
        _saveError = null;
        Item.MergedJsonContent = null;
        if (Item.Decision == DeployDecisionValue.Apply)
            Item.Decision = DeployDecisionValue.Pending;
        await JS.InvokeVoidAsync("monacoEditor.setValue", _editorId, DeployText);
        await OnDecisionChanged.InvokeAsync();
    }

    private async Task SaveMergeAsync()
    {
        _saveError = null;
        try
        {
            var currentText = await JS.InvokeAsync<string>("monacoEditor.getValue", _editorId);

            var targetPath = Item.DeployFullPath;
            if (targetPath is not null)
                await File.WriteAllTextAsync(targetPath, currentText, System.Text.Encoding.UTF8);

            Item.MergedJsonContent = currentText;
            Item.Decision = DeployDecisionValue.Apply;
            _isDirty = false;
            _savedOk = true;
            await OnDecisionChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _saveError = $"저장 실패: {ex.Message}";
        }
    }

    private static string DetectLanguage(string path) =>
        Path.GetExtension(path).ToLowerInvariant() switch
        {
            ".json"                          => "json",
            ".xml" or ".config" or ".csproj" => "xml",
            ".cs"                            => "csharp",
            ".js"                            => "javascript",
            ".ts"                            => "typescript",
            ".html" or ".cshtml" or ".razor" => "html",
            ".css"                           => "css",
            ".sql"                           => "sql",
            ".py"                            => "python",
            ".yaml" or ".yml"                => "yaml",
            ".md"                            => "markdown",
            _                                => "plaintext"
        };

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("monacoEditor.dispose", _editorId); }
        catch { }
        _dotNetRef?.Dispose();
    }
}
