@page "/deploy"
@using DeployTool.Models
@using DeployTool.Services
@inject DeploySession Session
@inject NavigationManager Nav

<PageTitle>경로 설정 — DeployTool</PageTitle>

<div class="page-header">
    <h1 class="page-title">
        <span class="title-icon"><i class="bi bi-folder2-open"></i></span>
        경로 설정
    </h1>
    <p class="page-subtitle">운영 서버 경로와 배포 파일 경로를 입력하세요.</p>
</div>

<div style="max-width:520px;display:flex;flex-direction:column;gap:20px;">

    <div class="form-section">
        <label class="form-label">
            <i class="bi bi-server me-1"></i>운영 경로
        </label>
        <div style="display:flex;gap:8px;">
            <input class="form-control" placeholder="예: D:\NETS\O365M"
                   @bind="Session.ProductionPath" style="flex:1;" />
            <button class="btn btn-outline-secondary btn-sm"
                    style="flex-shrink:0;white-space:nowrap;"
                    @onclick="() => OpenPicker(true)">
                <i class="bi bi-folder2-open"></i> 폴더 선택
            </button>
        </div>
        <div class="field-hint">실제 서비스가 구동 중인 폴더</div>
    </div>

    <div class="form-section">
        <label class="form-label">
            <i class="bi bi-box-arrow-in-down me-1"></i>배포 파일 경로
        </label>
        <div style="display:flex;gap:8px;">
            <input class="form-control" placeholder="예: D:\imprep"
                   @bind="Session.DeployPath" style="flex:1;" />
            <button class="btn btn-outline-secondary btn-sm"
                    style="flex-shrink:0;white-space:nowrap;"
                    @onclick="() => OpenPicker(false)">
                <i class="bi bi-folder2-open"></i> 폴더 선택
            </button>
        </div>
        <div class="field-hint">새로 빌드된 파일이 위치한 폴더</div>
    </div>

    @if (_errorMessage is not null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle me-2"></i>@_errorMessage
        </div>
    }

    <button type="button"
            class="btn btn-primary"
            style="align-self:flex-start;min-width:160px;"
            @onclick="GoToScopeAsync"
            @onclick:preventDefault="true">
        <i class="bi bi-arrow-right-circle"></i>
        <span>다음 단계</span>
    </button>

    <div class="info-box">
        <div class="info-box-title"><i class="bi bi-info-circle me-1"></i>안내</div>
        <ul>
            <li>경로를 입력하면 다음 단계에서 폴더 목록을 자동으로 불러옵니다</li>
            <li>전체 비교 또는 원하는 폴더만 선택해 부분 배포할 수 있습니다</li>
            <li>각 서버에서 독립적으로 실행하세요</li>
        </ul>
    </div>

</div>

@code {
    private string? _errorMessage;

    private async Task OpenPicker(bool forProduction)
    {
        var path = await Task.Run(() =>
        {
            string? result = null;
            var thread = new System.Threading.Thread(() =>
            {
                using var owner = new ForegroundWindow();
                using var dlg = new System.Windows.Forms.FolderBrowserDialog
                {
                    Description = forProduction ? "운영 경로 선택" : "배포 파일 경로 선택",
                    UseDescriptionForTitle = true,
                    ShowNewFolderButton = false,
                    SelectedPath = forProduction
                        ? Session.ProductionPath
                        : Session.DeployPath
                };
                if (dlg.ShowDialog(owner) == System.Windows.Forms.DialogResult.OK)
                    result = dlg.SelectedPath;
            });
            thread.SetApartmentState(System.Threading.ApartmentState.STA);
            thread.Start();
            thread.Join();
            return result;
        });

        if (path is null) return;
        if (forProduction)
            Session.ProductionPath = path;
        else
            Session.DeployPath = path;
        StateHasChanged();
    }

    private void GoToScopeAsync()
    {
        _errorMessage = null;

        if (!Directory.Exists(Session.ProductionPath))
        {
            _errorMessage = $"운영 경로가 존재하지 않습니다: {Session.ProductionPath}";
            return;
        }
        if (!Directory.Exists(Session.DeployPath))
        {
            _errorMessage = $"배포 경로가 존재하지 않습니다: {Session.DeployPath}";
            return;
        }

        Session.Scope = new ScopeSelection();
        Session.CurrentStep = DeployStep.ScopeSelect;
        Nav.NavigateTo("/deploy/scope");
    }

    // FolderBrowserDialog에 오너 핸들을 제공해 브라우저 뒤로 숨는 문제를 방지한다.
    private sealed class ForegroundWindow : System.Windows.Forms.IWin32Window, IDisposable
    {
        [System.Runtime.InteropServices.DllImport("user32.dll")]
        private static extern bool SetForegroundWindow(IntPtr hWnd);

        [System.Runtime.InteropServices.DllImport("user32.dll")]
        private static extern IntPtr GetForegroundWindow();

        private readonly System.Windows.Forms.NativeWindow _nativeWindow = new();

        public ForegroundWindow()
        {
            var cp = new System.Windows.Forms.CreateParams
            {
                Style = 0x800000,   // WS_BORDER
                ExStyle = 0x8,      // WS_EX_TOPMOST
                Width = 0,
                Height = 0,
            };
            _nativeWindow.CreateHandle(cp);
            SetForegroundWindow(_nativeWindow.Handle);
        }

        public IntPtr Handle => _nativeWindow.Handle;

        public void Dispose() => _nativeWindow.DestroyHandle();
    }
}
