@page "/deploy/review"
@using DeployTool.Models
@using DeployTool.Services
@using DeployTool.Components
@inject DeploySession Session
@inject DiffEngine DiffEngine
@inject FileScanner FileScanner
@inject DeployConfigService ConfigService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>변경 검토 — DeployTool</PageTitle>

<div class="page-header" style="margin-bottom:16px;">
    <h1 class="page-title">
        <span class="title-icon"><i class="bi bi-git"></i></span>
        변경사항 검토
    </h1>
</div>

<div class="toolbar" style="border-radius:var(--r) var(--r) 0 0;margin-bottom:0;">
    <div class="stats-row" style="margin-bottom:0;gap:8px;">
        <div class="stat-chip added">
            <i class="bi bi-plus-circle-fill" style="font-size:11px;"></i>
            <span class="stat-count">@_addedCount</span>
            <span>추가</span>
        </div>
        <div class="stat-chip deleted">
            <i class="bi bi-dash-circle-fill" style="font-size:11px;"></i>
            <span class="stat-count">@_deletedCount</span>
            <span>삭제</span>
        </div>
        <div class="stat-chip changed">
            <i class="bi bi-pencil-fill" style="font-size:11px;"></i>
            <span class="stat-count">@_modifiedCount</span>
            <span>변경</span>
        </div>
        <div class="stat-chip">
            <span class="stat-count">@_applyCount</span>
            <span>적용</span>
        </div>
        @if (_ruleSkipCount > 0)
        {
            <div class="stat-chip" title="@($"스킵 규칙에 의해 스킵된 파일 (설정: {ConfigService.ConfigFilePath} 의 skipPatterns)")">
                <i class="bi bi-funnel-fill" style="font-size:11px;"></i>
                <span class="stat-count">@_ruleSkipCount</span>
                <span>규칙 스킵</span>
            </div>
        }
    </div>

    <div class="toolbar-spacer"></div>

    <label style="user-select:none;display:flex;align-items:center;gap:8px;cursor:pointer;">
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" @bind="_showChangesOnly" @bind:after="OnToggleChangesOnly" />
        </div>
        <span style="font-size:12.5px;color:var(--c-text-2);">변경만 보기</span>
    </label>

    <button class="btn @(_showEditableOnly ? "btn-primary" : "btn-outline-secondary") btn-sm"
            @onclick="() => _showEditableOnly = !_showEditableOnly"
            title=".json .config .xml .cs .js 등 편집 가능한 설정 파일만 표시">
        <i class="bi bi-gear"></i> 설정 파일만
    </button>

    <div style="display:flex;gap:6px;margin-left:4px;">
        @if (_isAllApplied)
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="SelectAllSkip">
                <i class="bi bi-skip-forward"></i> 전체 스킵
            </button>
        }
        else
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="SelectAllApply"
                    title="스킵 규칙에 해당하는 파일은 제외하고 전체 적용합니다">
                <i class="bi bi-check2-all"></i> 전체 적용
            </button>
        }
        <button class="btn btn-outline-secondary btn-sm" @onclick="RescanAsync" disabled="@_isRescanning"
                title="로컬 파일 변경사항을 반영해 목록을 다시 불러옵니다">
            @if (_isRescanning)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {
                <i class="bi bi-arrow-clockwise"></i>
            }
            <span> 새로고침</span>
        </button>
    </div>
</div>

<div style="display:flex;height:calc(100vh - 240px);border:1px solid var(--c-border);border-top:none;border-radius:0 0 var(--r) var(--r);overflow:hidden;">
    <div class="tree-pane" style="width:280px;flex-shrink:0;">
        @foreach (var node in _treeNodes)
        {
            <FileTreeNode @key="node"
                Item="@node.Item"
                FolderName="@node.FolderName"
                Children="@node.Children"
                Depth="0"
                ShowChangesOnly="@_showChangesOnly"
                ShowEditableOnly="@_showEditableOnly"
                SelectedItem="@_selectedItem"
                OnSelect="@OnItemSelected"
                OnToggleApply="@OnToggleApply" />
        }
    </div>
    <div class="tree-splitter" title="드래그해서 너비 조절 · 더블클릭 시 기본 너비"></div>

    <div class="detail-pane" style="flex:1;padding:0;overflow:hidden;display:flex;flex-direction:column;">
        @if (_selectedItem is null)
        {
            <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;color:var(--c-text-3);">
                <i class="bi bi-arrow-left-circle" style="font-size:32px;margin-bottom:12px;opacity:.4;"></i>
                <div style="font-size:13.5px;">왼쪽 트리에서 파일을 선택하세요</div>
            </div>
        }
        else if (_selectedItem.IsBinary)
        {
            <BinaryFilePanel Item="@_selectedItem" OnDecisionChanged="OnDecisionChanged" />
        }
        else if (_isLoadingDiff)
        {
            <div style="display:flex;align-items:center;justify-content:center;flex:1;color:var(--c-text-3);gap:10px;">
                <span class="spinner-border spinner-border-sm"></span>
                <span style="font-size:13px;">파일 로딩 중...</span>
            </div>
        }
        else
        {
            <TextDiffPanel Item="@_selectedItem"
                           ProductionText="@_productionText"
                           DeployText="@_deployText"
                           OnDecisionChanged="OnDecisionChanged" />
        }
    </div>
</div>

<div style="display:flex;align-items:center;gap:10px;margin-top:16px;">
    <button class="btn btn-success" @onclick="GoToBackup" disabled="@(_applyCount == 0)">
        <i class="bi bi-arrow-right-circle"></i>
        Step 4: 백업 시작
    </button>
    @if (_applyCount == 0)
    {
        <span style="font-size:12.5px;color:var(--c-text-3);">적용할 파일을 하나 이상 선택하세요.</span>
    }
</div>

@code {
    private bool _showChangesOnly = true;
    private bool _showEditableOnly;
    private bool _isRescanning;
    private FileChangeItem? _selectedItem;
    private List<FileTreeNodeModel> _treeNodes = [];
    private string _productionText = string.Empty;
    private string _deployText = string.Empty;
    private bool _isLoadingDiff;

    // Pre-computed counts — avoid LINQ on every render
    private int _addedCount;
    private int _deletedCount;
    private int _modifiedCount;
    private int _applyCount;
    private int _ruleSkipCount;
    private bool _isAllApplied;

    // DLL ↔ PDB 세트 처리를 위한 경로 조회용
    private Dictionary<string, FileChangeItem> _itemsByPath = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        // BuildTree is O(N) now; run synchronously — no await needed
        RebuildTree();
        RefreshCounts();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 저장된 트리 영역 너비 복원
        if (firstRender)
            await JS.InvokeVoidAsync("treeSplitter.restore");
    }

    private void RebuildTree()
    {
        _treeNodes = FileTreeNodeModel.BuildTree(Session.Changes);
        _itemsByPath = Session.Changes.ToDictionary(
            c => c.RelativePath, StringComparer.OrdinalIgnoreCase);
    }

    private void RefreshCounts()
    {
        _addedCount   = Session.Changes.Count(c => c.Status == FileChangeStatus.Added);
        _deletedCount = Session.Changes.Count(c => c.Status == FileChangeStatus.Deleted);
        _modifiedCount = Session.Changes.Count(c => c.Status == FileChangeStatus.Modified);
        RefreshDecisionCounts();
    }

    private void RefreshDecisionCounts()
    {
        _applyCount    = Session.Changes.Count(c => c.Decision == DeployDecisionValue.Apply);
        _ruleSkipCount = Session.Changes.Count(c => c.SkipRule is not null && c.Decision == DeployDecisionValue.Skip);

        // 규칙 대상을 제외한 변경 파일이 모두 적용 상태면 토글 버튼은 "전체 스킵"으로 표시
        var targets = Session.ChangedItems.Where(c => c.SkipRule is null).ToList();
        _isAllApplied = targets.Count > 0 && targets.All(c => c.Decision == DeployDecisionValue.Apply);
    }

    private void OnDecisionChanged()
    {
        if (_selectedItem is not null)
            SyncLinkedPdb(_selectedItem);
        RefreshDecisionCounts();
        StateHasChanged();
    }

    private void OnToggleApply(DecisionToggle toggle)
    {
        var decision = toggle.Apply ? DeployDecisionValue.Apply : DeployDecisionValue.Skip;
        foreach (var item in toggle.Items)
        {
            item.Decision = decision;
            SyncLinkedPdb(item);
        }
        RefreshDecisionCounts();
    }

    // DLL의 결정을 같은 이름의 PDB에 그대로 반영
    private void SyncLinkedPdb(FileChangeItem item)
    {
        if (item.LinkedPdbPath is not null &&
            _itemsByPath.TryGetValue(item.LinkedPdbPath, out var pdb) &&
            pdb.Status != FileChangeStatus.Identical)
            pdb.Decision = item.Decision;
    }

    private void OnToggleChangesOnly() { /* bind:after triggers re-render automatically */ }

    private async Task OnItemSelected(FileChangeItem? item)
    {
        _selectedItem = item;
        _productionText = string.Empty;
        _deployText = string.Empty;
        _isLoadingDiff = false;

        if (item is null || item.IsBinary) return;

        await LoadDiffAsync(item);
    }

    private void SelectAllApply()
    {
        // 스킵 규칙 대상은 유지 — 필요하면 트리 체크박스로 개별 적용
        foreach (var item in Session.ChangedItems)
            item.Decision = item.SkipRule is null ? DeployDecisionValue.Apply : DeployDecisionValue.Skip;
        RefreshDecisionCounts();
    }

    private void SelectAllSkip()
    {
        foreach (var item in Session.ChangedItems)
            item.Decision = DeployDecisionValue.Skip;
        RefreshDecisionCounts();
    }

    private async Task RescanAsync()
    {
        _isRescanning = true;
        StateHasChanged();

        try
        {
            // 기존 결정(Decision) 보존을 위해 RelativePath → Decision 매핑 저장
            var previousDecisions = Session.Changes
                .Where(c => c.Decision != DeployDecisionValue.Pending)
                // 규칙에 의한 스킵은 저장하지 않음 — 재스캔 시 최신 규칙으로 다시 판정
                .Where(c => !(c.SkipRule is not null && c.Decision == DeployDecisionValue.Skip))
                .ToDictionary(c => c.RelativePath, c => c.Decision, StringComparer.OrdinalIgnoreCase);

            var scan = await FileScanner.ScanChangesAsync(
                Session.ProductionPath, Session.DeployPath, Session.Scope);
            var newChanges = scan.Changes;
            Session.EmptyDeployOnlyDirectories = scan.EmptyDeployOnlyDirectories;

            // 스킵 규칙을 먼저 적용한 뒤 이전 결정으로 덮어써 사용자 선택을 우선한다
            ConfigService.Reload();
            var config = await ConfigService.LoadAsync();
            SkipRuleMatcher.Apply(newChanges, config.SkipPatterns);

            // 이전 결정 복원
            foreach (var item in newChanges)
            {
                if (previousDecisions.TryGetValue(item.RelativePath, out var decision))
                    item.Decision = decision;
            }

            Session.Changes = newChanges;

            // 선택된 파일이 재스캔 후에도 존재하면 유지, 없으면 초기화
            _selectedItem = _selectedItem is null
                ? null
                : newChanges.FirstOrDefault(c =>
                    c.RelativePath.Equals(_selectedItem.RelativePath, StringComparison.OrdinalIgnoreCase));

            RebuildTree();
            RefreshCounts();

            // 선택된 파일이 유지됐으면 diff 갱신
            if (_selectedItem is not null && !_selectedItem.IsBinary)
                await LoadDiffAsync(_selectedItem);
        }
        finally
        {
            _isRescanning = false;
        }
    }

    private async Task LoadDiffAsync(FileChangeItem item)
    {
        _productionText = string.Empty;
        _deployText = string.Empty;
        _isLoadingDiff = true;
        StateHasChanged();

        var (_, productionText, deployText) = await DiffEngine.ComputeFileDiffWithTextAsync(
            item.ProductionFullPath, item.DeployFullPath);
        _productionText = productionText;
        _deployText = deployText;
        _isLoadingDiff = false;
    }

    private void GoToBackup() => Nav.NavigateTo("/deploy/backup");
}
