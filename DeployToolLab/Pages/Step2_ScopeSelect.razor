@page "/deploy/scope"
@using DeployTool.Models
@using DeployTool.Services
@inject DeploySession Session
@inject FileScanner FileScanner
@inject NavigationManager Nav

<PageTitle>범위 선택 — DeployTool</PageTitle>

<div class="page-header">
    <h1 class="page-title">
        <span class="title-icon"><i class="bi bi-ui-checks"></i></span>
        배포 범위 선택
    </h1>
    <p class="page-subtitle">비교할 범위를 선택하세요. 프로젝트 단위로 좁히면 더 빠릅니다.</p>
</div>

<div style="max-width:720px;display:flex;flex-direction:column;gap:20px;">

    @* ── 비교 모드 선택 ── *@
    <div>
        <div class="section-label">비교 모드</div>
        <div class="d-flex gap-3">
            <label class="mode-card @(Session.Scope.Mode == ScopeMode.FullCompare ? "active" : "")"
                   @onclick="() => Session.Scope.Mode = ScopeMode.FullCompare">
                <div class="mode-card-radio @(Session.Scope.Mode == ScopeMode.FullCompare ? "checked" : "")">
                    @if (Session.Scope.Mode == ScopeMode.FullCompare)
                    { <div class="mode-card-radio-dot"></div> }
                </div>
                <div>
                    <div style="font-weight:600;font-size:13.5px;margin-bottom:3px;">전체 비교</div>
                    <div style="font-size:12px;color:var(--c-text-3);">모든 파일 비교 · 제외 패턴 자동 적용</div>
                </div>
            </label>

            <label class="mode-card @(Session.Scope.Mode == ScopeMode.ProjectSelect ? "active" : "")"
                   @onclick="() => Session.Scope.Mode = ScopeMode.ProjectSelect">
                <div class="mode-card-radio @(Session.Scope.Mode == ScopeMode.ProjectSelect ? "checked" : "")">
                    @if (Session.Scope.Mode == ScopeMode.ProjectSelect)
                    { <div class="mode-card-radio-dot"></div> }
                </div>
                <div>
                    <div style="font-weight:600;font-size:13.5px;margin-bottom:3px;">프로젝트 선택</div>
                    <div style="font-size:12px;color:var(--c-text-3);">원하는 폴더만 골라서 부분 배포</div>
                </div>
            </label>
        </div>
    </div>

    @* ── 전체 비교: 제외 패턴 ── *@
    @if (Session.Scope.Mode == ScopeMode.FullCompare)
    {
        <div class="form-section">
            <label class="form-label"><i class="bi bi-filter me-1"></i>제외 패턴</label>
            <textarea class="form-control" rows="6"
                      value="@_excludePatternsText"
                      @oninput="OnExcludePatternsInput"
                      @onkeydown:stopPropagation="true"
                      spellcheck="false"
                      placeholder="한 줄에 하나씩 입력하세요.&#10;폴더 제외: log/&#10;확장자 제외: *.log&#10;부분 경로 제외: Backup/"></textarea>
            <div class="field-hint">
                <i class="bi bi-info-circle me-1"></i>
                예시: <code style="font-size:11px;color:var(--c-accent);">log/</code> (폴더),
                <code style="font-size:11px;color:var(--c-accent);">*.log</code> (확장자),
                <code style="font-size:11px;color:var(--c-accent);">Backup/</code> (경로 포함)
            </div>
        </div>
    }

    @* ── 프로젝트 선택: 폴더 트리 ── *@
    @if (Session.Scope.Mode == ScopeMode.ProjectSelect)
    {
        @if (_isLoadingTree)
        {
            <div style="display:flex;align-items:center;gap:10px;color:var(--c-text-2);">
                <span class="spinner-border spinner-border-sm"></span>
                <span style="font-size:13px;">폴더 목록 불러오는 중...</span>
            </div>
        }
        else if (Session.Scope.FolderTree.Count == 0)
        {
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>폴더를 찾을 수 없습니다.
            </div>
        }
        else
        {
            <div>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                    <div class="section-label" style="margin:0;">폴더 선택</div>
                    <div style="display:flex;gap:8px;">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="SelectAll">전체 선택</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="SelectNone">전체 해제</button>
                    </div>
                </div>
                <div class="folder-checklist" style="max-height:420px;overflow-y:auto;">
                    @foreach (var node in Session.Scope.FolderTree)
                    {
                        <FolderTreeNode Node="node" OnChanged="StateHasChanged" />
                    }
                </div>
                <div style="font-size:12.5px;color:var(--c-text-2);margin-top:8px;">
                    <i class="bi bi-files me-1"></i>예상 대상:
                    <strong style="color:var(--c-text-1);">@Session.Scope.EstimatedTotalFiles 개</strong> 파일
                </div>
            </div>
        }
    }

    @* ── 분석 진행 중 ── *@
    @if (_isScanning)
    {
        <div class="scan-status-bar">
            <div class="spinner-border spinner-border-sm"></div>
            <div style="flex:1;min-width:0;">
                <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
                    <span style="font-size:12.5px;font-weight:600;">병렬 스캔 중...</span>
                    <span style="font-size:12px;color:var(--c-text-2);">
                        @_filesScanned 개
                        @if (_totalFiles > 0)
                        {
                            <span> / @_totalFiles 개</span>
                        }
                        <span> 처리됨</span>
                    </span>
                </div>
                <div class="progress-bar-track">
                    <div class="progress-bar-fill" style="width:@(_scanProgressWidth)%;"></div>
                </div>
                <div style="font-family:var(--mono);font-size:11.5px;color:var(--c-text-3);margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                    @_currentFile
                </div>
            </div>
        </div>

        @if (_partialChanges.Count > 0)
        {
            <div style="font-size:12px;color:var(--c-text-2);">
                <i class="bi bi-arrow-right-circle me-1" style="color:var(--c-accent);"></i>
                현재까지 발견:
                <span style="color:var(--c-green);font-weight:600;">+@_partialChanges.Count(c => c.Status == FileChangeStatus.Added)</span>
                <span style="color:var(--c-red);font-weight:600;margin-left:6px;">-@_partialChanges.Count(c => c.Status == FileChangeStatus.Deleted)</span>
                <span style="color:var(--c-yellow);font-weight:600;margin-left:6px;">~@_partialChanges.Count(c => c.Status == FileChangeStatus.Modified)</span>
            </div>
        }
    }
    else
    {
        <button class="btn btn-primary" style="align-self:flex-start;min-width:140px;" @onclick="StartScanAsync">
            <i class="bi bi-play-fill"></i>
            <span>분석 시작</span>
        </button>
    }

</div>

@code {
    private bool _isLoadingTree;
    private bool _isScanning;
    private string _currentFile = string.Empty;
    private int _filesScanned;
    private int _totalFiles;
    private int _scanProgressWidth;
    private List<FileChangeItem> _partialChanges = [];
    private System.Threading.Timer? _progressTimer;

    private string _excludePatternsText =>
        string.Join("\n", Session.Scope.ExcludePatterns);

    protected override async Task OnInitializedAsync()
    {
        if (Session.Scope.FolderTree.Count == 0)
            await LoadFolderTreeAsync();
    }

    private async Task LoadFolderTreeAsync()
    {
        _isLoadingTree = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            Session.Scope.FolderTree = await FileScanner.BuildFolderTreeAsync(
                Session.ProductionPath, Session.DeployPath);
        }
        finally
        {
            _isLoadingTree = false;
        }
    }

    private void OnExcludePatternsInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        Session.Scope.ExcludePatterns = [.. raw.Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.TrimEnd('\r'))];
    }

    private void SelectAll()
    {
        foreach (var node in Session.Scope.FolderTree.SelectMany(n => n.Flatten()))
            node.IsSelected = true;
    }

    private void SelectNone()
    {
        foreach (var node in Session.Scope.FolderTree.SelectMany(n => n.Flatten()))
            node.IsSelected = false;
    }

    private async Task StartScanAsync()
    {
        _isScanning = true;
        _filesScanned = 0;
        _totalFiles = 0;
        _scanProgressWidth = 0;
        _partialChanges = [];

        await Task.Yield();

        _progressTimer = new System.Threading.Timer(_ =>
        {
            if (_scanProgressWidth < 92) _scanProgressWidth += 1;
            InvokeAsync(StateHasChanged);
        }, null, 400, 200);

        var progress = new Progress<ScanProgress>(p =>
        {
            _currentFile = p.CurrentFile;
            _filesScanned = p.FilesScanned;
            _totalFiles = p.TotalFiles;
            _partialChanges = p.PartialResults;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            Session.Changes = await FileScanner.ScanChangesAsync(
                Session.ProductionPath, Session.DeployPath, Session.Scope, progress);
            Session.CurrentStep = DeployStep.Scan;
            Nav.NavigateTo("/deploy/review");
        }
        finally
        {
            _progressTimer?.Dispose();
            _isScanning = false;
        }
    }
}
