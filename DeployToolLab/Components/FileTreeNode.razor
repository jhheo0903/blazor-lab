@using DeployTool.Models

@if (_isVisible)
{
<div class="tree-node @(IsSelected ? "selected" : "")">
    <div class="tree-row @(_isSkipped ? "is-skipped" : "")" @onclick="Select">
        <span class="tree-toggle" @onclick:stopPropagation="true" @onclick="ToggleExpand">
            @if (_hasChildren)
            {
                <i class="bi @(_isExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
            }
        </span>

        @if (_checkState == CheckState.None)
        {
            <span class="tree-check"></span>
        }
        else
        {
            <span class="tree-check @(_checkState == CheckState.Unchecked ? "" : "on")"
                  title="@(_checkState == CheckState.Checked ? "체크 해제 시 스킵" : "체크 시 적용")"
                  @onclick:stopPropagation="true" @onclick="ToggleApply">
                <i class="bi @_checkIcon"></i>
            </span>
        }

        <span class="tree-icon">@_icon</span>
        <span class="tree-label" title="@_displayName">@_displayName</span>

        <div class="tree-badges">
            @if (_hasChildren)
            {
                @if (_addedCount > 0)   { <span class="badge badge-added">+@_addedCount</span> }
                @if (_deletedCount > 0) { <span class="badge badge-deleted">-@_deletedCount</span> }
                @if (_modifiedCount > 0){ <span class="badge badge-changed">~@_modifiedCount</span> }
            }
            else if (Item is not null)
            {
                @if (Item.SkipRule is not null && Item.Decision == DeployDecisionValue.Skip)
                {
                    <span class="badge badge-rule" title="스킵 규칙: @Item.SkipRule">
                        <i class="bi bi-funnel-fill"></i>
                    </span>
                }
                <span class="badge @_statusBadgeClass">@Item.StatusIcon</span>
                @if (Item.IsDowngrade)
                {
                    <span title="다운그레이드 감지" style="font-size:11px;">⚠️</span>
                }
            }
        </div>
    </div>

    @* Children are only rendered when expanded — DOM virtualization *@
    @if (_isExpanded && _hasChildren)
    {
        <div class="tree-children">
            @foreach (var child in _visibleChildren)
            {
                <FileTreeNode @key="child"
                    Item="@child.Item"
                    FolderName="@child.FolderName"
                    Children="@child.Children"
                    Depth="@(Depth + 1)"
                    ShowChangesOnly="@ShowChangesOnly"
                    ShowEditableOnly="@ShowEditableOnly"
                    SelectedItem="@SelectedItem"
                    OnSelect="@OnSelect"
                    OnToggleApply="@OnToggleApply" />
            }
        </div>
    }
</div>
}

@code {
    [Parameter] public FileChangeItem? Item { get; set; }
    [Parameter] public string? FolderName { get; set; }
    [Parameter] public List<FileTreeNodeModel> Children { get; set; } = [];
    [Parameter] public bool ShowChangesOnly { get; set; }
    [Parameter] public bool ShowEditableOnly { get; set; }
    [Parameter] public EventCallback<FileChangeItem?> OnSelect { get; set; }
    [Parameter] public EventCallback<DecisionToggle> OnToggleApply { get; set; }
    [Parameter] public FileChangeItem? SelectedItem { get; set; }
    [Parameter] public int Depth { get; set; }

    // Pre-computed on parameter set — never recalculated on re-render
    private bool _isVisible;
    private bool _isExpanded;
    private bool _userToggled; // 사용자가 명시적으로 토글했는지 여부
    private string _nodeKey = string.Empty; // 노드 식별자 — 바뀌면 상태 리셋
    private bool _hasChildren;
    private string _displayName = string.Empty;
    private string _icon = string.Empty;
    private string _statusBadgeClass = string.Empty;
    private int _addedCount;
    private int _deletedCount;
    private int _modifiedCount;
    private List<FileTreeNodeModel> _visibleChildren = [];

    private enum CheckState { None, Unchecked, Partial, Checked }
    private CheckState _checkState;
    private bool _isSkipped;

    private string _checkIcon => _checkState switch
    {
        CheckState.Checked => "bi-check-square-fill",
        CheckState.Partial => "bi-dash-square-fill",
        _                  => "bi-square"
    };

    private bool IsSelected => SelectedItem is not null && SelectedItem == Item;

    protected override void OnParametersSet()
    {
        _hasChildren = Children.Count > 0;
        _displayName = FolderName ?? Path.GetFileName(Item?.RelativePath) ?? string.Empty;

        // 노드가 바뀌면 (다른 파일/폴더로 컴포넌트 재사용 시) 토글 상태 리셋
        var key = FolderName ?? Item?.RelativePath ?? string.Empty;
        if (key != _nodeKey)
        {
            _nodeKey = key;
            _userToggled = false;
        }

        if (!_hasChildren)
        {
            _isExpanded = false;
        }
        else if (!_userToggled)
        {
            _isExpanded = false;
        }
        // else: 사용자가 명시적으로 토글한 상태 유지

        _icon = GetFileIcon();
        _statusBadgeClass = GetStatusBadgeClass();

        if (_hasChildren)
        {
            // Cache descendant counts — computed once per parameter change
            _addedCount = _deletedCount = _modifiedCount = 0;
            int decidable = 0, applied = 0;
            TallyDescendants(Children, ref decidable, ref applied);
            _checkState = decidable == 0 ? CheckState.None
                : applied == 0 ? CheckState.Unchecked
                : applied == decidable ? CheckState.Checked
                : CheckState.Partial;
            _isSkipped = false;
        }
        else
        {
            _checkState = Item is null || Item.Status == FileChangeStatus.Identical ? CheckState.None
                : Item.Decision == DeployDecisionValue.Apply ? CheckState.Checked
                : CheckState.Unchecked;
            _isSkipped = Item?.Decision == DeployDecisionValue.Skip;
        }

        RefreshVisibleChildren();
        RefreshVisibility();
    }

    private void RefreshVisibility()
    {
        // 폴더 노드는 항상 표시 (자식 필터링은 RefreshVisibleChildren이 담당)
        if (_hasChildren)
        {
            _isVisible = true;
            return;
        }

        // 파일 노드: 최상위(Depth==0)에서 직접 렌더될 때만 필터 적용
        // 하위 자식은 부모의 RefreshVisibleChildren에서 이미 필터링됨
        if (Depth == 0 && Item is not null)
        {
            if (ShowChangesOnly && Item.Status == FileChangeStatus.Identical)
            {
                _isVisible = false;
                return;
            }
            if (ShowEditableOnly && !IsEditableExtension(Item.RelativePath))
            {
                _isVisible = false;
                return;
            }
        }

        _isVisible = true;
    }

    private static bool IsEditableExtension(string path) =>
        FileTreeNodeModel.IsEditableExtension(path);

    // 체크박스 대상: 변경된 파일 중 현재 필터("설정 파일만")에 보이는 것
    private bool IsDecidable(FileChangeItem item) =>
        item.Status != FileChangeStatus.Identical &&
        (!ShowEditableOnly || IsEditableExtension(item.RelativePath));

    private void ToggleApply()
    {
        if (_checkState == CheckState.None) return;

        List<FileChangeItem> items = [];
        if (_hasChildren) CollectDecidable(Children, items);
        else if (Item is not null) items.Add(Item);

        // 완전히 체크된 상태면 전부 스킵, 그 외(미체크/부분)는 전부 적용
        OnToggleApply.InvokeAsync(new DecisionToggle(items, _checkState != CheckState.Checked));
    }

    private void CollectDecidable(List<FileTreeNodeModel> nodes, List<FileChangeItem> result)
    {
        foreach (var node in nodes)
        {
            if (node.Item is { } item && IsDecidable(item)) result.Add(item);
            if (node.Children.Count > 0) CollectDecidable(node.Children, result);
        }
    }

    private void RefreshVisibleChildren()
    {
        var filtered = ShowChangesOnly
            ? Children.Where(c => c.HasChanges)
            : Children.AsEnumerable();

        if (ShowEditableOnly)
            filtered = filtered.Where(c => c.HasEditableFiles);

        _visibleChildren = filtered.ToList();
    }

    private void ToggleExpand()
    {
        _userToggled = true;
        _isExpanded = !_isExpanded;
    }

    private void Select() => OnSelect.InvokeAsync(Item);

    private string GetFileIcon()
    {
        if (_hasChildren) return "📁";
        var ext = Path.GetExtension(Item?.RelativePath ?? string.Empty).ToLowerInvariant();
        return ext switch
        {
            ".dll" or ".exe" => "⚙️",
            ".pdb"           => "🔍",
            ".json"          => "{ }",
            ".xml" or ".config" => "📄",
            _                => "📝"
        };
    }

    private string GetStatusBadgeClass() => Item?.Status switch
    {
        FileChangeStatus.Added    => "badge-added",
        FileChangeStatus.Deleted  => "badge-deleted",
        FileChangeStatus.Modified => "badge-changed",
        _                         => "badge-same"
    };

    // 상태별 개수와 체크박스 집계를 한 번의 순회로 계산
    private void TallyDescendants(List<FileTreeNodeModel> nodes, ref int decidable, ref int applied)
    {
        foreach (var node in nodes)
        {
            if (node.Item is { } item)
            {
                switch (item.Status)
                {
                    case FileChangeStatus.Added:    _addedCount++; break;
                    case FileChangeStatus.Deleted:  _deletedCount++; break;
                    case FileChangeStatus.Modified: _modifiedCount++; break;
                }
                if (IsDecidable(item))
                {
                    decidable++;
                    if (item.Decision == DeployDecisionValue.Apply) applied++;
                }
            }
            if (node.Children.Count > 0)
                TallyDescendants(node.Children, ref decidable, ref applied);
        }
    }
}
